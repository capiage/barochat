{
  "name": "Gemini CLI Development Environment",
  "image": "microsoft.com",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Automatically installs Gemini CLI when the Codespace builds
  "postCreateCommand": "npm install -g @google/gemini-cli",

  // Auto-installs extensions when you or your friend open the codespace
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare",
        "ms-vscode.live-server"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  
  "remoteUser": "node"
}
